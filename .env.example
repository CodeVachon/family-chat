# Database
# host-facing URL (localhost reaches Docker)
#
DATABASE_USER=familyChat
DATABASE_PASS=familyChatPass
DATABASE_DB=familyChatDB
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASS}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_DB}

# Better-Auth
# generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Resend (transactional email + magic links)
RESEND_API_KEY=
EMAIL_FROM="Family Chat <onboarding@resend.dev>"

# Cloudinary (uploaded assets)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push (PWA background notifications)
# generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY is a public value but is read at runtime (served to the
# browser by the app) rather than inlined at build time, so it lives here too.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
